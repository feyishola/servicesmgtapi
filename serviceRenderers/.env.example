PORT=5000
MONGO_URI=mongodb://localhost:27017/service-mgt-app
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=change-me
# Optional. Without it, online presence is kept in memory (single instance only)
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed origins, or leave unset to allow all
CORS_ORIGIN=http://localhost:3000
# openstreetmap needs no key; mapquest/google/opencage etc. need GEOCODER_API_KEY
GEOCODER_PROVIDER=openstreetmap
GEOCODER_API_KEY=
